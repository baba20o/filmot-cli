# Filmot CLI environment configuration
# Copy this file either to:
#   - <current project>/.env for project-specific settings, or
#   - Filmot's per-user config.env for machine-wide settings.
#
# Per-user config.env locations:
#   Windows: %APPDATA%\filmot\config.env
#   macOS:   ~/Library/Application Support/filmot/config.env
#   Linux:   ${XDG_CONFIG_HOME:-~/.config}/filmot/config.env
#
# Existing process environment variables take precedence, followed by the
# per-user config.env and then the current working directory's .env.

# ── Filmot API (required) ────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Webshare residential proxy pool (recommended on AWS / GCP) ───
# Sign up: https://www.webshare.io/  →  residential plan
# Get token: https://dashboard.webshare.io/userapi/keys
WEBSHARE_API_TOKEN=

# Pool behavior (all optional)
# FILMOT_PROXY_MODE=proxy-only    # auto | proxy-only | direct-only
# FILMOT_PROXY_COUNTRIES=US,GB,CA # restrict to these ISO-2 country codes
# FILMOT_PROXY_REFRESH_HOURS=6
# FILMOT_PROXY_MAX_SESSIONS=50
# FILMOT_PROXY_RETRY_LIMIT=4
# FILMOT_PROXY_LEASE_SECONDS=120
# WEBSHARE_SESSION_FILE=/path/to/webshare_info.txt
#
# If WEBSHARE_SESSION_FILE is unset, Filmot uses webshare_info.txt in its
# per-user config directory. A legacy .filmot_data/webshare_info.txt is copied
# there on first use and deliberately retained.

# Legacy static-rotating endpoint (only used if WEBSHARE_API_TOKEN is unset)
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

# ── AWS Transcribe fallback (optional) ───────────────────────────
# Used by `filmot transcript --fallback aws` when YouTube has no captions.
# AWS_PROFILE=APIBoss
# AWS_REGION=us-east-1

# ── Storage overrides (optional) ─────────────────────────────────
# Research data stays project-local by default:
# FILMOT_DATA_DIR=/path/to/project/.filmot_data
#
# Machine-wide configuration, state, and cache follow the native OS/XDG
# directories. These overrides are mainly useful for portable/test setups:
# FILMOT_CONFIG_FILE=/path/to/config.env
# FILMOT_CONFIG_DIR=/path/to/config
# FILMOT_STATE_DIR=/path/to/state
# FILMOT_CACHE_DIR=/path/to/cache
# FILMOT_RATE_LIMIT_DB=/path/to/rate_limit.db
